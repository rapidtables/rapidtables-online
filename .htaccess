# Custom Error Documents
ErrorDocument 404 /404.html

# Canonical Clean URLs & 301 Redirection
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS and WWW (redirects rapidtables.online -> https://www.rapidtables.online)
  RewriteCond %{HTTP_HOST} ^(www\.)?rapidtables\.online$ [NC]
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^rapidtables\.online$ [NC]
  RewriteRule ^(.*)$ https://www.rapidtables.online/$1 [L,R=301]

  # 2. Redirect /index.html directly to root /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/ [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 2. Redirect old /about/ routes to clean root pages
  RewriteRule ^about/?$ /about.html [R=301,L]
  RewriteRule ^about/about\.html$ /about.html [R=301,L]
  RewriteRule ^about/privacy(\.html)?$ /privacy.html [R=301,L]
  RewriteRule ^about/terms(\.html)?$ /terms.html [R=301,L]
  RewriteRule ^about/contact(\.html)?$ /contact.html [R=301,L]

  # 2b. Redirect Category Suite directories to clean .html hubs
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(pdf|calc|tools|convert)/index\.html\ HTTP/ [NC]
  RewriteRule ^(pdf|calc|tools|convert)/index\.html$ /$1.html [R=301,L]

  RewriteRule ^(pdf|calc|tools|convert)/?$ /$1.html [R=301,L]

  # 3. Redirect /folder/index.html to /folder/
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*)/index\.html\ HTTP/ [NC]
  RewriteRule ^(.*)/index\.html$ /$1/ [R=301,L]

  # 4. Ensure trailing slash for directory requests
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !(/$)
  RewriteRule (.*) %{REQUEST_URI}/ [R=301,L]

  # 4b. CPX Super Admin Routing & Auto-Redirects
  RewriteRule ^cpx/assets/(.*)$ /assets/$1 [L]
  RewriteRule ^cpx/cpx-dashboard\.html$ /cpx-dashboard.html [R=301,L]
  RewriteRule ^cpx/cpx-login\.html$ /cpx-login.html [R=301,L]
  RewriteRule ^cpx/dashboard(\.html)?$ /cpx-dashboard.html [R=301,L]
  RewriteRule ^cpx/login(\.html)?$ /cpx-login.html [R=301,L]
  RewriteRule ^cpx/?$ /cpx-dashboard.html [L]

  # 4c. CPX Super Admin Backend API Handlers
  RewriteRule ^api/cpx/(.*)$ /api/cpx.php?endpoint=$1 [QSA,L]
  RewriteRule ^api/site-settings/?$ /api/cpx.php?endpoint=site-settings [QSA,L]

  # 5. Clean Extensionless URLs (e.g. /about/privacy -> /about/privacy.html)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Force PHP Execution Handler (Hostinger LiteSpeed / Apache)
<FilesMatch "\.php$">
  SetHandler application/x-httpd-php
</FilesMatch>
<IfModule mime_module>
  AddType application/x-httpd-php .php
  AddHandler application/x-httpd-php .php
</IfModule>

# Enable browser caching and compression for RapidTables.online
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
